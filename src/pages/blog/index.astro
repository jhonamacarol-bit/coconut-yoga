---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const faseLabel: Record<string, string> = {
  folicular:  'Fase Folicular',
  ovulatoria: 'Ovulação',
  lutea:      'Fase Lútea',
  menstrual:  'Menstruação',
};
---

<Base title="Blog — Coconut Yoga" description="Artigos sobre alimentação, ciclo menstrual e bem-estar.">

  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">todos os artigos</span>
      <h1>leituras para <em>você</em></h1>
      <p>Conteúdo sobre alimentação, ciclo e bem-estar — sem dietas, sem culpa.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <!-- FILTER -->
      <div class="filter-bar">
        <button class="filter-btn active" data-filter="all">todos</button>
        {Object.entries(faseLabel).map(([key, label]) => (
          <button class="filter-btn" data-filter={key}>{label.toLowerCase()}</button>
        ))}
      </div>

      <!-- GRID -->
      <div class="cards-grid cards-grid--3" id="posts-grid">
        {sorted.map(post => (
          <a
            href={`/blog/${post.slug}`}
            class={`article-card fase-${post.data.fase}`}
            data-fase={post.data.fase}
          >
            <div class="article-card__img">
              <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
                <circle cx="22" cy="22" r="16" fill="var(--fase-color)" opacity="0.18"/>
                <circle cx="22" cy="22" r="8"  fill="var(--fase-color)" opacity="0.35"/>
              </svg>
            </div>
            <div class="article-card__body">
              <span class="fase-badge">{faseLabel[post.data.fase]}</span>
              <div class="article-card__title">{post.data.title}</div>
              <p style="font-size:13px;margin:0;">{post.data.description}</p>
              <div class="article-card__meta">
                {new Date(post.data.pubDate).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}
                · {post.data.readTime} min
              </div>
            </div>
          </a>
        ))}
      </div>

      {sorted.length === 0 && (
        <p style="text-align:center; padding: 60px 0; color: var(--bark-light);">
          Em breve os primeiros artigos. Volte logo!
        </p>
      )}

    </div>
  </section>

</Base>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-fase]');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      cards.forEach(card => {
        const show = filter === 'all' || card.dataset.fase === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>

<style>
.page-hero {
  padding: clamp(48px, 8vw, 96px) 0 clamp(32px, 5vw, 56px);
  background: var(--cream-dark);
  border-bottom: 1px solid var(--sand);
}
.page-hero h1 em { color: var(--terra); font-style: italic; }
.page-hero p { margin-top: 12px; max-width: 50ch; }

.eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--terra);
  margin-bottom: 12px;
}

.section { padding: clamp(40px, 6vw, 72px) 0; }

.filter-bar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 32px;
}
.filter-btn {
  padding: 8px 18px;
  border-radius: 100px;
  border: 1px solid var(--sand);
  background: white;
  font-family: var(--font-body);
  font-size: 12px;
  font-weight: 400;
  color: var(--bark-mid);
  cursor: pointer;
  transition: all 0.15s;
}
.filter-btn:hover { border-color: var(--terra-light); color: var(--bark); }
.filter-btn.active {
  background: var(--bark);
  border-color: var(--bark);
  color: var(--cream);
}

.cards-grid { display: grid; gap: 20px; }
.cards-grid--3 { grid-template-columns: repeat(3, 1fr); }

@media (max-width: 768px) {
  .cards-grid--3 { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 480px) {
  .cards-grid--3 { grid-template-columns: 1fr; }
}
</style>
