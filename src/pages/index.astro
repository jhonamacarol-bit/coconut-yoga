
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';

<h1>TESTE</h1>

const posts = await getCollection('blog');
const featured = posts.filter(p => p.data.featured).slice(0, 3);
const recent = posts.sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);

const hp = await getEntry('paginas', 'homepage');
const h = hp.data;

const faseLabel: Record<string, string> = {
  folicular:  'fase folicular',
  ovulatoria: 'ovulação',
  lutea:      'fase lútea',
  menstrual:  'menstruação',
};

---

<Base>
 
  <!-- ── HERO ── -->
 <section class="hero">
  <div class="container hero-inner">

    <!-- TEXTO -->
    <div class="hero-text fade-up">
      <span class="eyebrow">natureza feminina e lua</span>
      <h1>eu vivo entre os ciclos do meu corpo e da lua</h1>
      <p>a minha vida funciona de forma mais intuitiva, artística e sensível. ao longo dos anos, eu percebi que não funciono exatamente igual todos os dias. quando eu comecei a respeitar isso, tudo ficou mais leve e natural.</p>

      <div class="hero-actions">
        <a href="/ciclo" class="btn btn-primary">ver ciclos e alimentação</a>
      </div>
    </div>

    <!-- CARDS -->
    <div class="hero-cards fade-up-2">

      <div class="phase-card phase-card--folicular">
        <span class="fase-badge fase-folicular">folicular · sem 1–2</span>
        <p>esses são dias em que eu sinto mais leveza no corpo e mais clareza na mente. tenho vontade de me movimentar, escrever e começar coisas novas.</p>
      </div>

      <div class="phase-card phase-card--ovulatoria">
        <span class="fase-badge fase-ovulatoria">ovulatória · sem 2–3</span>
        <p>aqui eu me sinto mais aberta e presente. tenho mais vontade de me comunicar, criar e aparecer. minha energia fica mais confiante.</p>
      </div>

      <div class="phase-card phase-card--lutea">
        <span class="fase-badge fase-lutea">lútea · sem 3–4</span>
        <p>nessa fase eu começo a desacelerar. fico mais introspectiva e o corpo pede mais comida e mais pausa.</p>
      </div>

      <div class="phase-card phase-card--menstrual">
        <span class="fase-badge fase-menstrual">menstruação</span>
        <p>aqui é pausa. minha energia diminui e eu simplifico tudo.</p>
      </div>
    </div>
  </div>
    <div class="hero-scroll-hint">↓</div>
  </section>

  <!-- ── FEATURED ARTICLES ── -->
  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>leituras para você</h2>
          <a href="/blog" class="section-link">ver todos →</a>
        </div>
        <div class="cards-grid cards-grid--3">
          {featured.map(post => (
            <a href={`/blog/${post.slug}`} class={`article-card fase-${post.data.fase}`}>
              <div class="article-card__img">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="18" fill="var(--fase-color)" opacity="0.15"/>
                  <circle cx="24" cy="24" r="10" fill="var(--fase-color)" opacity="0.25"/>
                  <circle cx="24" cy="24" r="4"  fill="var(--fase-color)" opacity="0.5"/>
                </svg>
              </div>
              <div class="article-card__body">
                <span class="fase-badge">{faseLabel[post.data.fase]}</span>
                <div class="article-card__title">{post.data.title}</div>
                <p style="font-size:13px; margin:0;">{post.data.description}</p>
                <div class="article-card__meta">{post.data.readTime} min · {post.data.categoria}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── CICLO GUIDE ── -->
  <section class="section section--tinted">
    <div class="container">
      <div class="ciclo-grid">
        <div class="ciclo-text">
          <span class="eyebrow">entenda o ciclo</span>
          <h2>quatro fases, quatro formas de se nutrir</h2>
          <p>O seu ciclo menstrual não é só menstruação. São quatro fases distintas, cada uma com necessidades hormonais, energéticas e nutricionais diferentes.</p>
          <a href="/ciclo" class="btn btn-primary" style="margin-top:16px">explorar as fases</a>
        </div>
        <div class="ciclo-phases">
          {[
            { fase: 'folicular',  num: '01', nome: 'Folicular',  dias: 'dias 1–13', cor: 'sage' },
            { fase: 'ovulatoria', num: '02', nome: 'Ovulatória', dias: 'dia 14',    cor: 'terra' },
            { fase: 'lutea',      num: '03', nome: 'Lútea',      dias: 'dias 15–28', cor: 'lavender' },
            { fase: 'menstrual',  num: '04', nome: 'Menstrual',  dias: 'dias 1–5',  cor: 'rose' },
          ].map(f => (
            <a href={`/ciclo#${f.fase}`} class={`ciclo-item fase-${f.fase}`}>
              <span class="ciclo-num">{f.num}</span>
              <div>
                <strong>{f.nome}</strong>
                <small>{f.dias}</small>
              </div>
              <span class="ciclo-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── MANIFESTO ── -->
  <section class="manifesto">
    <div class="container manifesto-inner">
      <div class="manifesto-text">
       <h2>um lugar para quem sente demais</h2>
<p>eu não acredito em dieta. acredito em observar, ajustar e repetir o que funciona. isso muda a forma como você se vê, se cuida e se entende.</p>
      </div>
      <div class="manifesto-values">
       {[
  { titulo: 'ciclos', texto: 'Aqui eu compartilho o meu estilo de vida e tudo o que me influencia, respeitando os meus ciclos, fases e a forma como a minha energia muda ao longo do tempo. Eu acredito que a vida não é linear, e que entender esses movimentos, do corpo, da mente e até da lua, muda completamente a forma como a gente se organiza e se trata.' },
  { titulo: 'alimentação', texto: 'Energia, fome e humor caminham juntos. Para mim, um corpo bonito é um corpo saudável. A forma como eu me alimento não vem de regras rígidas, mas de uma escuta constante do meu corpo, entendendo o que me sustenta, o que me dá energia e o que me faz sentir bem de verdade. Eu acredito em uma alimentação simples, consistente e funcional, que respeita o momento, evita excessos e constrói uma base sólida ao longo do tempo.' },
  { titulo: 'diário pessoal', texto: 'Aqui, você e eu nos acompanhamos. Eu compartilho meus processos de forma real, os ajustes, os aprendizados, as fases boas e as que exigem mais de mim, porque evoluir é sobre continuidade. A ideia é crescer juntas, com mais consciência, mais presença e construindo uma rotina que faça sentido na prática, não só na teoria.' },
]}
        ].map(v => (
          <div class="value-pill">
            <strong>{v.titulo}</strong>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── RECENT POSTS ── -->
  {recent.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>últimos textos</h2>
          <a href="/blog" class="section-link">ver todos →</a>
        </div>
        <div class="cards-grid cards-grid--3">
          {recent.map(post => (
            <a href={`/blog/${post.slug}`} class={`article-card fase-${post.data.fase}`}>
              <div class="article-card__img">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="20" r="14" fill="var(--fase-color)" opacity="0.18"/>
                  <circle cx="20" cy="20" r="7"  fill="var(--fase-color)" opacity="0.35"/>
                </svg>
              </div>
              <div class="article-card__body">
                <span class="fase-badge">{faseLabel[post.data.fase]}</span>
                <div class="article-card__title">{post.data.title}</div>
                <div class="article-card__meta">{post.data.readTime} min · {post.data.categoria}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── NEWSLETTER CTA ── -->
  <section class="section newsletter-section">
  <div class="container">
    <div class="newsletter-box">

      <div class="newsletter-box__text">
        <h2>vamos nos conectar?</h2>
        <p>
          e-mails com o que eu estou testando, ajustando e mantendo na minha rotina. sem filtro, sem fórmula.
        </p>
        <p style="font-size:12px; opacity:0.7;">
          sem spam. sem insistência. por aqui eu falo com mais calma.
        </p>
      </div>

      <form class="newsletter-box__form" method="POST" action="https://405d3274.sibforms.com/serve/MUIFAN8Y2aHduBvnlCJPJExB7vCpgHHtoxazlU3xVWZL9cOZ-9G2aPhr1e5EMpCclm01OOatFCI0iaR415HvZkMYJDUfvMcGN4c3-fTySVMjGPta6f_bVK62GblFeq-1E82_fwP_oLFNo9HWMOsYxs5NovgNrDEA-JUhQ1qwK8LZmUIt1La_XCXuFCEkMYITDX8C1d-uWzqOuQNrqQ==" data-type="subscription">
        <input type="text" placeholder="seu nome" name="FIRSTNAME" />
        <input type="email" placeholder="seu e-mail" name="EMAIL" required />
        <button type="submit" class="btn btn-primary">receber</button>
        <input type="text" name="email_address_check" value="" style="display:none">
        <input type="hidden" name="locale" value="pt">
        <small>cancele quando quiser · seus dados são seus</small>
      </form>

    </div>
  </div>
</section>
<script>
  if (new URLSearchParams(window.location.search).get('inscrita')) {
    document.getElementById('inscrita-msg').style.display = 'block';
  }
</script>

</Base>

<style>
/* HERO */
.hero {
  padding: clamp(60px, 10vw, 120px) 0 clamp(40px, 6vw, 80px);
  position: relative;
}
.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.eyebrow {
  display: inline-block;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--terra);
  margin-bottom: 16px;
}
.hero-text h1 em { color: var(--terra); font-style: italic; }
.hero-text p { margin: 20px 0 32px; max-width: 44ch; font-size: 15px; }
.hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

.hero-cards { display: flex; flex-direction: column; gap: 12px; }
.phase-card {
  background: white;
  border: 1px solid var(--sand);
  border-radius: var(--radius-md);
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  transition: all 0.25s ease;
}
.fase-ovulatoria {
  color: var(--terra);
}

.phase-card--ovulatoria {
  border-color: rgba(210, 140, 90, 0.2);
}

.phase-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.06);
}

.phase-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(0,0,0,0.06);
  border-color: var(--terra-light);
}
.phase-card--folicular:hover {
  border-color: #B8CBB8;
}

.phase-card--ovulatoria:hover {
  border-color: #D28C5A;
}

.phase-card--lutea:hover {
  border-color: #A89BBF;
}

.phase-card--menstrual:hover {
  border-color: #D8A7A7;
}
.hero-scroll-hint {
  text-align: center;
  margin-top: 48px;
  color: var(--bark-light);
  font-size: 20px;
  animation: bounce 2s infinite;
}
@keyframes bounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* SECTIONS */
.section { padding: clamp(48px, 8vw, 96px) 0; }
.section--tinted { background: var(--cream-dark); }
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 32px;
}
.section-link { font-size: 13px; color: var(--terra); font-weight: 500; }
.section-link:hover { text-decoration: underline; }

/* CARDS GRID */
.cards-grid { display: grid; gap: 20px; }
.cards-grid--3 { grid-template-columns: repeat(3, 1fr); }

/* CICLO */
.ciclo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}
.ciclo-text h2 em { color: var(--terra); font-style: italic; }
.ciclo-text p { margin: 16px 0; }
.ciclo-phases { display: flex; flex-direction: column; gap: 8px; }
.ciclo-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  background: white;
  border: 1px solid var(--sand);
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}
.ciclo-item:hover {
  border-color: var(--fase-color);
  transform: translateX(4px);
}
.ciclo-num {
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--fase-color);
  opacity: 0.6;
  min-width: 36px;
}
.ciclo-item strong { display: block; font-size: 14px; font-weight: 500; color: var(--bark); }
.ciclo-item small { font-size: 11px; color: var(--bark-light); }
.ciclo-arrow { margin-left: auto; color: var(--bark-light); font-size: 14px; }

/* MANIFESTO */
.manifesto {
  background: var(--bark);
  padding: clamp(48px, 8vw, 96px) 0;
}
.manifesto-inner {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 60px;
  align-items: start;
}
.manifesto-text h2 { color: var(--cream); }
.manifesto-text h2 em { color: var(--terra-light); font-style: italic; }
.manifesto-text p { color: var(--bark-light); margin-top: 16px; }
.manifesto-values { display: flex; flex-direction: column; gap: 12px; }
.value-pill {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-md);
  padding: 18px 20px;
}
.value-pill strong { display: block; font-size: 14px; font-weight: 500; color: var(--cream); margin-bottom: 6px; }
.value-pill p { font-size: 13px; color: var(--bark-light); margin: 0; }

/* NEWSLETTER */
.newsletter-section { background: var(--cream-dark); }
.newsletter-box {
  background: white;
  border: 1px solid var(--sand);
  border-radius: var(--radius-lg);
  padding: clamp(32px, 5vw, 56px);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: center;
}
.newsletter-box__text h2 em { color: var(--terra); font-style: italic; }
.newsletter-box__text p { margin-top: 12px; }
.newsletter-box__form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.newsletter-box__form input {
  padding: 12px 18px;
  border: 1px solid var(--sand);
  border-radius: var(--radius-pill);
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--bark);
  background: var(--cream);
  outline: none;
  transition: border-color 0.2s;
}
.newsletter-box__form input:focus { border-color: var(--terra); }
.newsletter-box__form input::placeholder { color: var(--bark-light); }
.newsletter-box__form .btn { align-self: flex-start; }
.newsletter-box__form small { font-size: 11px; color: var(--bark-light); }

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero-inner { grid-template-columns: 1fr; }
  .hero-cards { display: grid; grid-template-columns: 1fr 1fr; }
  .ciclo-grid { grid-template-columns: 1fr; }
  .manifesto-inner { grid-template-columns: 1fr; }
  .newsletter-box { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .cards-grid--3 { grid-template-columns: 1fr; }
  .hero-cards { grid-template-columns: 1fr; }
  .section-header { flex-direction: column; gap: 8px; }
}
.inscrita-msg {
  background: #EAF4EE;
  border: 1px solid #C3DEC9;
  color: #3A6B45;
  text-align: center;
  padding: 14px 24px;
  border-radius: var(--radius-pill);
  font-size: 14px;
  margin-bottom: 24px;
}
.hero-animal {
  width: 60px;
  margin-bottom: 12px;
  display: block;
}

@media (max-width: 900px) {
  .hero-animal {
    margin-inline: auto;
  }
}
</style>
