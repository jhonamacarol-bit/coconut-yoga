---
import BaseVenda from '../layouts/BaseVenda.astro';
---

<BaseVenda title="Diário de Alimentação Cíclica — Coconut Yoga">

  <div class="pagina-venda">
    <img src="/pagina-vendas.png" alt="Diário de Alimentação Cíclica — Coconut Yoga" class="imagem-venda" />

    <div class="botoes-flutuantes">
      <a href="https://pay.kiwify.com.br/DRYrrAj" target="_blank" class="btn-comprar">
        abrir meu diário
      </a>
    </div>
  </div>

</BaseVenda>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    min-height: 100vh;
    background: #F5F0E8;
  }

  body {
    font-family: 'Georgia', serif;
  }

  .pagina-venda {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    background: #F5F0E8;
  }

  .imagem-venda {
    width: 100%;
    height: auto;
    display: block;
  }

  .botoes-flutuantes {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    justify-content: center;
  }

  .btn-comprar {
    background: #1C1A17;
    color: #F5F0E8;
    padding: 16px 40px;
    font-family: 'Georgia', serif;
    font-size: 15px;
    font-style: italic;
    text-decoration: none;
    border-radius: 2px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    transition: all 0.2s;
    white-space: nowrap;
    letter-spacing: 0.5px;
  }

  .btn-comprar:hover {
    background: #333;
    transform: translateY(-2px);
  }
</style>
